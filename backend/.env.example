# Football Intelligence Backend Configuration
# Copy this file to .env and configure your environment

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/football_intelligence
# For development, you can use SQLite:
# DATABASE_URL=sqlite:///./football_intelligence.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# AI Provider (Ollama)
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
