# Football Intelligence Backend Configuration
# Copy this file to .env and configure your environment

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/football_intelligence
# For development, you can use SQLite:
# DATABASE_URL=sqlite:///./football_intelligence.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# AI Provider (Ollama)
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Provider Configuration
# USE_REAL_PROVIDERS controls whether to use actual football data providers or DevelopmentProvider
# Set to false for testing/development with mock data
# Set to true to enable real data ingestion from Ryzellx/FotMob/OpenLigaDB
USE_REAL_PROVIDERS=false

# Provider URLs (used when USE_REAL_PROVIDERS=true)
RYZELLX_BASE_URL=https://football-live-api.vercel.app
FOTMOB_BASE_URL=https://www.fotmob.com/api
OPENLIGADB_BASE_URL=https://api.openligadb.de

# Provider Behavior
PROVIDER_TIMEOUT_SECONDS=10.0
PROVIDER_RETRY_COUNT=2

# Feature Engineering
TEAM_FORM_WINDOW=5
MIN_SAMPLE_SIZE=3

